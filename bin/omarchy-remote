#!/usr/bin/env bash
# omarchy-remote — browser remote desktop for Omarchy.
#
# Pipeline:  browser -> (Tailscale | Pangolin) -> noVNC :6080 -> wayvnc :5900 -> Hyprland
# Both local services listen on 127.0.0.1 only; nothing is exposed until you
# publish it with `omarchy-remote tailscale on` or `omarchy-remote pangolin connect`.
#
# Run as your normal desktop user (not root). sudo is used only where needed.

set -euo pipefail

VERSION="0.4.0"

# ---- settings (override in ~/.config/omarchy-remote/config) -----------------
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-remote/config"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-remote"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
VNC_PORT=5900
WEB_PORT=6080
NOVNC_REPO="https://github.com/novnc/noVNC"
NOVNC_REF="master"
WEBSOCKIFY_REPO="https://github.com/novnc/websockify"
WEBSOCKIFY_REF="master"
PANGOLIN_ENDPOINT="https://app.pangolin.net"
PANGOLIN_API="https://api.pangolin.net/v1"
PUBLIC_VIA="pangolin"  # provider used when --auth is given without --via
NOVNC_QUALITY=6        # 0-9, lower = smaller/faster
NOVNC_COMPRESSION=2    # 0-9, higher = more CPU, less bandwidth
# shellcheck source=/dev/null
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

NOVNC_DIR="$DATA_DIR/novnc"
PG_DIR="$(dirname "$CONFIG_FILE")"
PG_KEY_FILE="$PG_DIR/pangolin.key"   # API key only, mode 600
PG_ENV_FILE="$PG_DIR/pangolin.env"   # org/site/domain ids (not secret)
TS_MAP_FILE="$PG_DIR/tailscale.map"  # "<name> <port>" per private exposure
CF_KEY_FILE="$PG_DIR/cloudflare.key"            # Cloudflare API token, mode 600
CF_ENV_FILE="$PG_DIR/cloudflare.env"            # account/zone/tunnel ids (not secret)
CF_TUNNEL_TOKEN_FILE="$PG_DIR/cloudflare-tunnel.token"  # cloudflared run token, mode 600
CF_UNIT="omarchy-remote-tunnel.service"
VNC_UNIT="omarchy-remote-vnc.service"
WEB_UNIT="omarchy-remote-web.service"

# ---- helpers ----------------------------------------------------------------
c_ok=$'\e[32m'; c_warn=$'\e[33m'; c_err=$'\e[31m'; c_dim=$'\e[2m'; c_off=$'\e[0m'
[[ -t 1 ]] || { c_ok=""; c_warn=""; c_err=""; c_dim=""; c_off=""; }
info() { printf '%s==>%s %s\n' "$c_ok" "$c_off" "$*"; }
warn() { printf '%s!!%s  %s\n' "$c_warn" "$c_off" "$*" >&2; }
die()  { printf '%sxx%s  %s\n' "$c_err" "$c_off" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

require_user() {
  [[ $EUID -ne 0 ]] || die "Run as your desktop user, not root (sudo is used where needed)."
}

hypr_env() {
  # Locate the running Hyprland instance (works from systemd --user and SSH).
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -d "$XDG_RUNTIME_DIR/hypr" ]]; then
    # Instance dirs are plain hex/timestamp names; newest = current session.
    # shellcheck disable=SC2012
    HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
    export HYPRLAND_INSTANCE_SIGNATURE
  fi
  [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]
}

ts_url() {
  have tailscale || return 1
  tailscale status --json 2>/dev/null \
    | python3 -c 'import sys,json; print("https://"+json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null
}

# ---- commands ---------------------------------------------------------------
cmd_setup() {
  require_user
  have pacman || die "This tool targets Omarchy / Arch Linux (pacman not found)."
  have hyprctl || warn "hyprctl not found — is this an Omarchy (Hyprland) machine?"

  if pacman -T wayvnc git python >/dev/null; then
    info "Packages already installed (wayvnc, git, python)"
  else
    info "Installing packages (wayvnc, git, python)…"
    sudo pacman -S --needed --noconfirm wayvnc git python
  fi

  info "Installing noVNC into $NOVNC_DIR"
  mkdir -p "$DATA_DIR"
  if [[ ! -d "$NOVNC_DIR/.git" ]]; then
    git clone -q --depth 1 --branch "$NOVNC_REF" "$NOVNC_REPO" "$NOVNC_DIR"
  fi
  if [[ ! -d "$NOVNC_DIR/utils/websockify/.git" ]]; then
    git clone -q --depth 1 --branch "$WEBSOCKIFY_REF" "$WEBSOCKIFY_REPO" "$NOVNC_DIR/utils/websockify"
  fi
  write_novnc_defaults
  ln -sf vnc.html "$NOVNC_DIR/index.html"   # so https://host/ opens the desktop

  migrate_legacy_units
  write_units

  info "Starting services…"
  systemctl --user daemon-reload
  systemctl --user enable --now "$VNC_UNIT" "$WEB_UNIT"
  sleep 2
  cmd_status
  cat <<EOF

Next step — publish it:
  omarchy-remote tailscale on        # private: only your tailnet devices
  omarchy-remote pangolin connect    # public URL with login (share with others)
EOF
}

write_novnc_defaults() {
  cat > "$NOVNC_DIR/defaults.json" <<EOF
{"autoconnect": true, "resize": "scale", "reconnect": true, "quality": $NOVNC_QUALITY, "compression": $NOVNC_COMPRESSION}
EOF
}

write_units() {
  mkdir -p "$UNIT_DIR"
  local self; self="$(readlink -f "$0")"
  cat > "$UNIT_DIR/$VNC_UNIT" <<EOF
[Unit]
Description=omarchy-remote: wayvnc (Hyprland desktop on 127.0.0.1:$VNC_PORT)
# No After=graphical-session.target: the target already orders itself after the
# units it wants, so that line plus web's After=vnc formed a cycle and systemd
# dropped the web unit at login. ensure-display + Restart= cover a late Hyprland.
PartOf=graphical-session.target

[Service]
ExecStartPre=$self ensure-display
ExecStart=/usr/bin/wayvnc 127.0.0.1 $VNC_PORT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
EOF
  cat > "$UNIT_DIR/$WEB_UNIT" <<EOF
[Unit]
Description=omarchy-remote: noVNC web client (127.0.0.1:$WEB_PORT)
After=$VNC_UNIT
PartOf=graphical-session.target

[Service]
ExecStart=$NOVNC_DIR/utils/novnc_proxy --vnc 127.0.0.1:$VNC_PORT --listen 127.0.0.1:$WEB_PORT
# novnc_proxy exits 143 on SIGTERM; treat that as a clean stop
SuccessExitStatus=143
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
EOF
}

migrate_legacy_units() {
  # Earlier manual setups used plain wayvnc.service / novnc.service on the same ports.
  local u
  for u in wayvnc.service novnc.service; do
    if [[ -f "$UNIT_DIR/$u" ]] && grep -qE '127\.0\.0\.1[: ](5900|6080)' "$UNIT_DIR/$u"; then
      warn "Replacing legacy $u with omarchy-remote units"
      systemctl --user disable --now "$u" 2>/dev/null || true
      systemctl --user reset-failed "$u" 2>/dev/null || true
      mv "$UNIT_DIR/$u" "$UNIT_DIR/$u.bak"
    fi
  done
}

cmd_ensure_display() {
  # Called before wayvnc starts: if no monitor is attached, create a virtual one.
  hypr_env || { echo "Hyprland not running yet"; exit 1; }
  if ! hyprctl monitors 2>/dev/null | grep -q '^Monitor'; then
    echo "No monitor attached — creating a headless output"
    hyprctl output create headless >/dev/null
  fi
}

cmd_status() {
  local u state
  echo "omarchy-remote $VERSION"
  for u in "$VNC_UNIT" "$WEB_UNIT"; do
    state="$(systemctl --user is-active "$u" 2>/dev/null || true)"
    if [[ "$state" == active ]]; then
      printf '  %-28s %sactive%s\n' "$u" "$c_ok" "$c_off"
    else
      printf '  %-28s %s%s%s\n' "$u" "$c_err" "${state:-not installed}" "$c_off"
    fi
  done
  if have tailscale && tailscale serve status 2>/dev/null | grep -q "127.0.0.1:$WEB_PORT"; then
    printf '  %-28s %s%s%s\n' "tailscale serve" "$c_ok" "$(ts_url || echo on)" "$c_off"
  else
    printf '  %-28s %soff%s\n' "tailscale serve" "$c_dim" "$c_off"
  fi
  if systemctl is-active --quiet pangolin-site 2>/dev/null; then
    printf '  %-28s %sconnected (URL: see Pangolin dashboard)%s\n' "pangolin site" "$c_ok" "$c_off"
  else
    printf '  %-28s %soff%s\n' "pangolin site" "$c_dim" "$c_off"
  fi
  printf '  %-28s http://127.0.0.1:%s\n' "local" "$WEB_PORT"
}

cmd_tailscale() {
  have tailscale || die "tailscale is not installed (sudo pacman -S tailscale)."
  case "${1:-}" in
    on)
      sudo tailscale serve --bg "$WEB_PORT"
      info "Private URL (tailnet only): $(ts_url || echo 'see: tailscale serve status')"
      ;;
    off)
      sudo tailscale serve --https=443 off
      info "Tailscale serve disabled"
      ;;
    *) die "usage: omarchy-remote tailscale on|off" ;;
  esac
}

# ---- Pangolin Integration API ----------------------------------------------
# pg_api METHOD PATH [JSON] — prints the response body; fails on HTTP/API errors.
# The key is passed to curl through a pipe-backed config file, never on argv.
pg_api() {
  local -; set +x   # never trace this function: it handles the API key
  local method="$1" path="$2" out
  local data=(); [[ -n "${3:-}" ]] && data=(--data-binary "$3")
  [[ -r "$PG_KEY_FILE" ]] || die "Not logged in to Pangolin. Run: omarchy-remote pangolin login"
  out="$(curl -sS --max-time 30 -X "$method" "$PANGOLIN_API$path" \
           -K <(printf 'header = "Authorization: Bearer %s"\n' "$(<"$PG_KEY_FILE")") \
           -H 'Content-Type: application/json' "${data[@]}" \
           -w '\n%{http_code}')" || die "Pangolin API request failed: $method $path"
  local code="${out##*$'\n'}"; out="${out%$'\n'*}"
  if [[ "$code" != 2* ]]; then
    die "Pangolin API $method $path -> HTTP $code: $(json_get "$out" "d.get('message')" 2>/dev/null || echo "$out")"
  fi
  printf '%s\n' "$out"
}

# json_get JSON EXPR — evaluate a Python expression against the parsed JSON (bound to d).
json_get() {
  python3 -c 'import sys,json; d=json.loads(sys.argv[1]); r=eval(sys.argv[2]); print(r if isinstance(r,str) else json.dumps(r))' "$1" "$2"
}

pg_load() {
  [[ -r "$PG_ENV_FILE" ]] || die "Not logged in to Pangolin. Run: omarchy-remote pangolin login"
  # shellcheck source=/dev/null
  source "$PG_ENV_FILE"
}

# pick LABEL — read "id<TAB>name" lines on stdin; auto-pick a single one, else ask.
pick() {
  local label="$1" rows n choice
  mapfile -t rows
  n=${#rows[@]}
  ((n > 0)) || die "No $label found in this Pangolin organization."
  if ((n == 1)); then printf '%s\n' "${rows[0]%%$'\t'*}"; return; fi
  local i; for i in "${!rows[@]}"; do printf '  %d) %s\n' $((i+1)) "${rows[i]#*$'\t'}" >&2; done
  read -rp "Choose $label [1-$n]: " choice
  if ! [[ "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > n)); then die "Invalid choice."; fi
  printf '%s\n' "${rows[choice-1]%%$'\t'*}"
}

pangolin_login() {
  cat <<EOF
Create an API key in the Pangolin dashboard: Organization -> API Keys -> Generate.
Give it read/write on resources, targets, domains, sites, and access tokens.
EOF
  local org key sites site_id domains domain_id base
  read -rp "Organization ID (the part after app.pangolin.net/ in the dashboard URL): " org
  read -rsp "API key (hidden): " key; echo
  [[ -n "$org" && -n "$key" ]] || die "Organization ID and API key are required."

  mkdir -p "$PG_DIR"
  ( umask 077; printf '%s' "$key" > "$PG_KEY_FILE" )
  unset key

  sites="$(pg_api GET "/org/$org/sites?pageSize=100")" \
    || { rm -f "$PG_KEY_FILE"; exit 1; }
  site_id="$(json_get "$sites" "'\n'.join(str(s['siteId'])+'\t'+s['name'] for s in d['data']['sites'])" | pick site)"

  domains="$(pg_api GET "/org/$org/domains")"
  # Only NS-delegated domains can host <name>.<domain> for every new service.
  domain_id="$(json_get "$domains" "'\n'.join(x['domainId']+'\t'+x['baseDomain'] for x in d['data']['domains'] if x['verified'] and x['type']=='ns')" | pick "NS-delegated domain")"
  base="$(json_get "$domains" "next(x['baseDomain'] for x in d['data']['domains'] if x['domainId']=='$domain_id')")"

  ( umask 077; cat > "$PG_ENV_FILE" <<EOF
PG_ORG=$org
PG_SITE_ID=$site_id
PG_DOMAIN_ID=$domain_id
PG_BASE_DOMAIN=$base
EOF
  )
  info "Logged in to Pangolin org '$org'. New services will be published as https://<name>.$base"
}

# ---- expose / unexpose / list ----------------------------------------------
# Resources we create are named "omarchy-remote:<name>:<auth>" so `list` can
# tell them apart from ones made by hand and show how each is protected.
PG_TAG="omarchy-remote"

valid_name() { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; }

# Print "resourceId<TAB>name<TAB>fullDomain" for every public resource in the org.
pg_resources() {
  local r; r="$(pg_api GET "/org/$PG_ORG/public-resources?pageSize=1000")"
  json_get "$r" "'\n'.join(str(x['resourceId'])+'\t'+x['name']+'\t'+(x.get('fullDomain') or '') for x in d['data']['resources'])"
}

pg_resource_id() {   # pg_resource_id FQDN -> resourceId (empty if none)
  pg_resources | awk -F'\t' -v h="$1" '$3 == h { print $1; exit }'
}

rand_secret() { python3 -c 'import secrets; print(secrets.token_urlsafe(18))'; }

cmd_expose() {
  local name="" port="" via="" auth="" allow="" user="omarchy" yes_public=0
  while (($#)); do
    case "$1" in
      --via)        via="${2:-}"; shift 2 ;;
      --via=*)      via="${1#*=}"; shift ;;
      --private)    via=tailscale; shift ;;          # alias kept from 0.2
      --auth)       auth="${2:-}"; shift 2 ;;
      --auth=*)     auth="${1#*=}"; shift ;;
      --allow)      allow="${2:-}"; shift 2 ;;
      --allow=*)    allow="${1#*=}"; shift ;;
      --user)       user="${2:-}"; shift 2 ;;
      --yes-public) yes_public=1; shift ;;
      -*)           die "Unknown option: $1" ;;
      *)  if [[ -z "$name" ]]; then name="$1"; elif [[ -z "$port" ]]; then port="$1"; else die "Unexpected argument: $1"; fi; shift ;;
    esac
  done
  [[ -n "$name" && -n "$port" ]] || die "usage: omarchy-remote expose <name> <port> [--via tailscale|pangolin|cloudflare] [--auth login|token|password|bearer|none]"
  valid_name "$name" || die "Name must be lowercase letters, digits and dashes (it becomes the subdomain)."
  if ! [[ "$port" =~ ^[0-9]+$ ]] || ((port < 1 || port > 65535)); then die "Invalid port: $port"; fi

  # No --via: private by default; asking for an auth mode means a public URL.
  # bearer exists only on Cloudflare, so it picks Cloudflare by itself.
  if [[ -z "$via" ]]; then
    if [[ -z "$auth" ]]; then via=tailscale
    elif [[ "$auth" == bearer ]]; then via=cloudflare
    else via="$PUBLIC_VIA"; fi
  fi
  case "$via" in
    tailscale)
      [[ -z "$auth" ]] || die "Tailscale URLs are private to your tailnet and take no --auth. For a public URL with a login use --via pangolin (or cloudflare)."
      ;;
    pangolin|cloudflare)
      case "$auth" in
        login|token|password|bearer) ;;
        none) ((yes_public)) || die "--auth none makes $name public to the whole internet. Add --yes-public to confirm." ;;
        "")   die "Public URLs need --auth login|token|password|bearer|none (or drop --via for a private Tailscale URL)." ;;
        *)    die "Unknown --auth '$auth' (login|token|password|bearer|none)." ;;
      esac
      if [[ "$via" == pangolin && "$auth" == bearer ]]; then
        die "--auth bearer is only available with --via cloudflare (Pangolin can't check Bearer keys)."
      fi
      if [[ "$via" == cloudflare && "$auth" =~ ^(login|token|password)$ ]]; then
        die "--auth $auth isn't supported with Cloudflare yet (it needs Cloudflare Access). Use --via pangolin, or --auth bearer|none."
      fi
      [[ -z "$allow" || "$auth" == login ]] || die "--allow only applies to --auth login."
      ;;
    *) die "Unknown --via '$via' (tailscale|pangolin|cloudflare)." ;;
  esac
  [[ -n "$(expose_owner "$name")" ]] && die "'$name' is already exposed. Run: omarchy-remote unexpose $name"
  ss -Hltn "sport = :$port" 2>/dev/null | grep -q . || warn "Nothing is listening on port $port yet — the URL will fail until it is."

  case "$via" in
    tailscale)  ts_expose "$name" "$port" ;;
    pangolin)   pg_expose "$name" "$port" "$auth" "$allow" "$user" ;;
    cloudflare) cf_expose "$name" "$port" "$auth" ;;
  esac
}

# expose_owner NAME -> "tailscale" / "pangolin" / "" (not exposed)
expose_owner() {
  if [[ -f "$TS_MAP_FILE" ]] && awk -v n="$1" '$1 == n { f=1 } END { exit !f }' "$TS_MAP_FILE"; then
    echo tailscale; return
  fi
  if [[ -r "$PG_ENV_FILE" ]]; then
    pg_load
    [[ -n "$(pg_resource_id "$1.$PG_BASE_DOMAIN")" ]] && { echo pangolin; return; }
  fi
  if [[ -r "$CF_ENV_FILE" ]]; then
    cf_load
    [[ "$(cf_dns_comment "$1.$CF_ZONE")" == "$PG_TAG:"* ]] && echo cloudflare
  fi
  return 0
}

# ---- Tailscale (private) ----------------------------------------------------
# Without an operator set (sudo tailscale set --operator=$USER), serve needs root.
ts_cmd() { tailscale "$@" 2>/dev/null || sudo tailscale "$@"; }

ts_expose() {
  local name="$1" port="$2"
  have tailscale || die "tailscale is not installed (see README: One-time setup: Tailscale)."
  if [[ -f "$TS_MAP_FILE" ]] && awk -v p="$port" '$2 == p { f=1 } END { exit !f }' "$TS_MAP_FILE"; then
    die "Port $port is already published privately under another name (omarchy-remote list)."
  fi
  ts_cmd serve --bg --https="$port" "http://127.0.0.1:$port" >/dev/null
  mkdir -p "$PG_DIR"; echo "$name $port" >> "$TS_MAP_FILE"
  info "Exposed privately: $(ts_url || echo "https://<this-machine>.ts.net"):$port  (only devices in your tailnet)"
}

ts_unexpose() {
  local name="$1" port
  port="$(awk -v n="$name" '$1 == n { print $2; exit }' "$TS_MAP_FILE")"
  ts_cmd serve --https="$port" off >/dev/null
  awk -v n="$name" '$1 != n' "$TS_MAP_FILE" > "$TS_MAP_FILE.tmp" && mv "$TS_MAP_FILE.tmp" "$TS_MAP_FILE"
  info "Removed private URL for $name (port $port)"
}

# ---- Pangolin (public) ------------------------------------------------------
pg_expose() {
  local name="$1" port="$2" auth="$3" allow="$4" user="$5"
  pg_load
  local fqdn="$name.$PG_BASE_DOMAIN" r id
  [[ -z "$(pg_resource_id "$fqdn")" ]] || die "$fqdn is already exposed. Run: omarchy-remote unexpose $name"

  info "Creating https://$fqdn -> 127.0.0.1:$port"
  r="$(pg_api PUT "/org/$PG_ORG/public-resource" \
        "{\"name\":\"$PG_TAG:$name:$auth\",\"subdomain\":\"$name\",\"domainId\":\"$PG_DOMAIN_ID\",\"mode\":\"http\"}")"
  id="$(json_get "$r" "str(d['data']['resourceId'])")"
  # From here on, delete the half-made resource if any later step fails (die exits).
  trap 'warn "Rolling back $fqdn"; pg_api DELETE "/public-resource/'"$id"'" >/dev/null || true' EXIT

  pg_api PUT "/public-resource/$id/target" \
    "{\"siteId\":$PG_SITE_ID,\"ip\":\"127.0.0.1\",\"port\":$port,\"method\":\"http\",\"enabled\":true}" >/dev/null

  local pass emails tok
  case "$auth" in
    none)
      pg_api POST "/public-resource/$id" '{"sso":false,"emailWhitelistEnabled":false}' >/dev/null
      ;;
    login)
      if [[ -n "$allow" ]]; then
        emails="$(python3 -c 'import sys,json; print(json.dumps([e.strip() for e in sys.argv[1].split(",") if e.strip()]))' "$allow")"
        pg_api POST "/public-resource/$id" '{"sso":true,"emailWhitelistEnabled":true}' >/dev/null
        pg_api POST "/public-resource/$id/whitelist" "{\"emails\":$emails}" >/dev/null
      else
        pg_api POST "/public-resource/$id" '{"sso":true}' >/dev/null
      fi
      ;;
    password)
      pass="$(rand_secret)"
      pg_api POST "/public-resource/$id" '{"sso":false,"emailWhitelistEnabled":false}' >/dev/null
      pg_api POST "/public-resource/$id/header-auth" \
        "{\"user\":\"$user\",\"password\":\"$pass\",\"extendedCompatibility\":true}" >/dev/null
      ;;
    token)
      pg_api POST "/public-resource/$id" '{"sso":true}' >/dev/null
      tok="$(pg_api POST "/public-resource/$id/access-token" "{\"title\":\"$PG_TAG:$name\"}")"
      ;;
  esac
  trap - EXIT

  info "Exposed: https://$fqdn  (auth: $auth)"
  echo "  A new address needs ~30s for its certificate; 404 or connection errors until then are normal."
  case "$auth" in
    none)  warn "Anyone on the internet can open it." ;;
    login) echo "  Opens a login page. Allowed: members of your Pangolin org${allow:+ + $allow (email code)}" ;;
    password)
      echo "  User: $user   Password: $pass   (shown once — save it)"
      echo "  curl -u '$user:$pass' https://$fqdn/" ;;
    token)
      json_get "$tok" "'  Token ID: '+str(d['data']['accessTokenId'])+'   Token: '+d['data']['accessToken']+'   (shown once — save it)\n  curl -H \"P-Access-Token-Id: '+str(d['data']['accessTokenId'])+'\" -H \"P-Access-Token: '+d['data']['accessToken']+'\" https://$fqdn/'" ;;
  esac
}

# ---- Cloudflare (public) ----------------------------------------------------
# Tunnel (one per machine, run by a user unit) + proxied CNAME per service.
# --auth bearer adds a WAF custom rule that blocks requests without the key.
CF_API="https://api.cloudflare.com/client/v4"

# cf_api [--soft] METHOD PATH [JSON] — body on stdout. Dies on API errors unless --soft
# (then returns 1). The token goes to curl through a pipe-backed config, never argv.
cf_api() {
  local -; set +x   # never trace this function: it handles the API token
  local soft=0; [[ "$1" == --soft ]] && { soft=1; shift; }
  local method="$1" path="$2" out code
  local data=(); [[ -n "${3:-}" ]] && data=(--data-binary "$3")
  [[ -s "$CF_KEY_FILE" ]] || die "Not logged in to Cloudflare. Run: omarchy-remote cloudflare login"
  out="$(curl -sS --max-time 30 -X "$method" "$CF_API$path" \
           -K <(printf 'header = "Authorization: Bearer %s"\n' "$(<"$CF_KEY_FILE")") \
           -H 'Content-Type: application/json' "${data[@]}" -w '\n%{http_code}')" \
    || die "Cloudflare API request failed: $method $path"
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  if [[ "$code" != 2* ]]; then
    ((soft)) && { printf '%s\n' "$out"; return 1; }
    die "Cloudflare API $method $path -> HTTP $code: $(json_get "$out" "'; '.join(e.get('message','') for e in d.get('errors') or [])" 2>/dev/null || echo "$out")"
  fi
  printf '%s\n' "$out"
}

cf_load() {
  [[ -r "$CF_ENV_FILE" ]] || die "Not logged in to Cloudflare. Run: omarchy-remote cloudflare login"
  # shellcheck source=/dev/null
  source "$CF_ENV_FILE"
}

cf_login() {
  cat <<EOF
Create an API token at dash.cloudflare.com -> My Profile -> API Tokens -> Custom token:
  Account: Cloudflare Tunnel (Edit)      Zone: DNS (Edit), Zone WAF (Edit), Zone (Read)
limited to your account and the zone (domain) you want to use.
EOF
  local key zones zone_id
  read -rsp "API token (hidden): " key; echo
  [[ -n "$key" ]] || die "No token entered (nothing saved)."
  mkdir -p "$PG_DIR"
  ( umask 077; printf '%s' "$key" > "$CF_KEY_FILE" )
  info "Saved token (${#key} characters)"
  unset key
  cf_api GET /user/tokens/verify >/dev/null || { rm -f "$CF_KEY_FILE"; exit 1; }
  zones="$(cf_api GET "/zones?per_page=50")"
  zone_id="$(json_get "$zones" "'\n'.join(z['id']+'\t'+z['name'] for z in d['result'])" | pick "zone (domain)")"
  json_get "$zones" "next('CF_ZONE_ID=%s\nCF_ZONE=%s\nCF_ACCOUNT=%s' % (z['id'], z['name'], z['account']['id']) for z in d['result'] if z['id']=='$zone_id')" \
    | ( umask 077; cat > "$CF_ENV_FILE" )
  cf_load
  info "Logged in to Cloudflare. Public services will be https://<name>.$CF_ZONE"
}

cf_bin() {
  local b; b="$(command -v cloudflared || true)"
  [[ -n "$b" ]] && { echo "$b"; return; }
  b="$HOME/.local/bin/cloudflared"
  if [[ ! -x "$b" ]]; then
    info "Downloading cloudflared (github.com/cloudflare/cloudflared releases)…" >&2
    mkdir -p "$(dirname "$b")"
    curl -fsSL -o "$b.tmp" https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64
    chmod +x "$b.tmp"; mv "$b.tmp" "$b"
  fi
  echo "$b"
}

# Create (or reuse) this machine's tunnel and make sure its user unit runs.
cf_ensure_tunnel() {
  local name r
  name="$PG_TAG-$(hostname -s)"
  if [[ -z "${CF_TUNNEL_ID:-}" ]]; then
    r="$(cf_api GET "/accounts/$CF_ACCOUNT/cfd_tunnel?is_deleted=false&name=$name")"
    CF_TUNNEL_ID="$(json_get "$r" "d['result'][0]['id'] if d['result'] else ''")"
    if [[ -z "$CF_TUNNEL_ID" ]]; then
      info "Creating Cloudflare tunnel $name"
      r="$(cf_api POST "/accounts/$CF_ACCOUNT/cfd_tunnel" "{\"name\":\"$name\",\"config_src\":\"cloudflare\"}")"
      CF_TUNNEL_ID="$(json_get "$r" "d['result']['id']")"
    fi
    echo "CF_TUNNEL_ID=$CF_TUNNEL_ID" >> "$CF_ENV_FILE"
  fi
  if [[ ! -s "$CF_TUNNEL_TOKEN_FILE" ]]; then
    r="$(cf_api GET "/accounts/$CF_ACCOUNT/cfd_tunnel/$CF_TUNNEL_ID/token")"
    json_get "$r" "d['result']" | ( umask 077; tr -d '\n' > "$CF_TUNNEL_TOKEN_FILE" )
  fi
  if [[ ! -f "$UNIT_DIR/$CF_UNIT" ]]; then
    mkdir -p "$UNIT_DIR"
    cat > "$UNIT_DIR/$CF_UNIT" <<EOF
[Unit]
Description=omarchy-remote: Cloudflare tunnel ($name)
After=network-online.target

[Service]
ExecStart=$(cf_bin) tunnel --no-autoupdate run --token-file $CF_TUNNEL_TOKEN_FILE
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
  fi
  systemctl --user enable --now "$CF_UNIT" >/dev/null 2>&1 || systemctl --user start "$CF_UNIT"
}

# cf_ingress add FQDN PORT | del FQDN — edit the tunnel's remotely-managed ingress list.
cf_ingress() {
  local r new
  r="$(cf_api GET "/accounts/$CF_ACCOUNT/cfd_tunnel/$CF_TUNNEL_ID/configurations")"
  new="$(python3 - "$r" "$1" "$2" "${3:-}" <<'PY'
import json, sys
d = json.loads(sys.argv[1]); op, host, port = sys.argv[2], sys.argv[3], sys.argv[4]
rules = [x for x in (((d.get("result") or {}).get("config") or {}).get("ingress") or [])
         if x.get("hostname") and x.get("hostname") != host]
if op == "add":
    rules.append({"hostname": host, "service": "http://127.0.0.1:%s" % port})
rules.append({"service": "http_status:404"})
print(json.dumps({"config": {"ingress": rules}}))
PY
)"
  cf_api PUT "/accounts/$CF_ACCOUNT/cfd_tunnel/$CF_TUNNEL_ID/configurations" "$new" >/dev/null
}

cf_dns_comment() {   # FQDN -> comment of its DNS record ("" if none; "-" if record has no comment)
  local r; r="$(cf_api GET "/zones/$CF_ZONE_ID/dns_records?name=$1")"
  json_get "$r" "(d['result'][0].get('comment') or '-') if d['result'] else ''"
}

cf_waf_ruleset() {   # -> id of the zone's custom-rules entrypoint ("" if none yet)
  local r
  r="$(cf_api --soft GET "/zones/$CF_ZONE_ID/rulesets/phases/http_request_firewall_custom/entrypoint")" || { echo ""; return 0; }
  json_get "$r" "d['result']['id']"
}

cf_waf_add() {   # cf_waf_add NAME FQDN KEY
  local rule rs
  rule="$(python3 -c 'import json,sys; n,h,k=sys.argv[1:4]; print(json.dumps({"description":"omarchy-remote:"+n,"action":"block","expression":"(http.host eq \"%s\" and not any(lower(http.request.headers[\"authorization\"][*])[*] eq \"bearer %s\"))" % (h,k)}))' "$1" "$2" "$3")"
  rs="$(cf_waf_ruleset)"
  if [[ -z "$rs" ]]; then
    cf_api PUT "/zones/$CF_ZONE_ID/rulesets/phases/http_request_firewall_custom/entrypoint" "{\"rules\":[$rule]}" >/dev/null
  else
    cf_api POST "/zones/$CF_ZONE_ID/rulesets/$rs/rules" "$rule" >/dev/null
  fi
}

cf_waf_del() {   # cf_waf_del NAME
  local rs r rid
  rs="$(cf_waf_ruleset)"; [[ -n "$rs" ]] || return 0
  r="$(cf_api GET "/zones/$CF_ZONE_ID/rulesets/$rs")"
  rid="$(json_get "$r" "next((x['id'] for x in d['result'].get('rules',[]) if x.get('description')=='omarchy-remote:$1'), '')")"
  [[ -z "$rid" ]] || cf_api DELETE "/zones/$CF_ZONE_ID/rulesets/$rs/rules/$rid" >/dev/null
}

# cf_probe FQDN -> HTTP status of https://FQDN/ without credentials. Resolves through
# Cloudflare DoH so a negative answer cached by the local resolver (the zone's SOA
# allows up to 30 min) doesn't hide a record we just created.
cf_probe() {
  local ip
  ip="$(curl -s --max-time 5 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=$1&type=A" \
        | python3 -c 'import sys,json; a=[x["data"] for x in json.load(sys.stdin).get("Answer",[]) if x.get("type")==1]; print(a[0] if a else "")' 2>/dev/null)"
  [[ -n "$ip" ]] || { echo 000; return; }
  curl -s -o /dev/null --max-time 5 --resolve "$1:443:$ip" -w '%{http_code}' "https://$1/" || true
}

cf_expose() {
  local name="$1" port="$2" auth="$3" fqdn c key="" code i
  cf_load
  fqdn="$name.$CF_ZONE"
  c="$(cf_dns_comment "$fqdn")"
  [[ -z "$c" ]] || die "$fqdn already has a DNS record (not made by omarchy-remote, or exposed already). Pick another name."
  cf_ensure_tunnel

  info "Creating https://$fqdn -> 127.0.0.1:$port (Cloudflare)"
  trap 'warn "Rolling back $fqdn"; cf_waf_del "'"$name"'" || true; r=$(cf_api --soft GET "/zones/$CF_ZONE_ID/dns_records?name='"$fqdn"'") && id=$(json_get "$r" "d[\"result\"][0][\"id\"] if d[\"result\"] else \"\"") && [[ -n "$id" ]] && cf_api --soft DELETE "/zones/$CF_ZONE_ID/dns_records/$id" >/dev/null; cf_ingress del "'"$fqdn"'" || true' EXIT
  if [[ "$auth" == bearer ]]; then
    key="sk-omr-$(python3 -c 'import secrets; print(secrets.token_hex(24))')"   # lowercase: the rule compares lower()-ed headers
    cf_waf_add "$name" "$fqdn" "$key"
  fi
  cf_ingress add "$fqdn" "$port"
  cf_api POST "/zones/$CF_ZONE_ID/dns_records" \
    "{\"type\":\"CNAME\",\"name\":\"$fqdn\",\"content\":\"$CF_TUNNEL_ID.cfargotunnel.com\",\"proxied\":true,\"comment\":\"$PG_TAG:$name:$auth\"}" >/dev/null

  # Self-check: a bearer URL must refuse requests without the key before we report success.
  if [[ "$auth" == bearer ]]; then
    info "Waiting for the key check to be active at Cloudflare's edge (up to 2 min)…"
    for i in $(seq 1 40); do
      code="$(cf_probe "$fqdn")"
      [[ "$code" == 403 ]] && break
      sleep 3
    done
    [[ "$code" == 403 ]] || die "The URL still answers without the key (HTTP $code) — not publishing it."
  fi
  trap - EXIT

  info "Exposed: https://$fqdn  (auth: $auth, via Cloudflare)"
  echo "  If a device looked this name up before it existed, its DNS cache may say 'not found' for up to 30 min."
  case "$auth" in
    none)   warn "Anyone on the internet can open it." ;;
    bearer)
      echo "  Key: $key   (shown once — save it)"
      echo "  curl -H 'Authorization: Bearer $key' https://$fqdn/"
      echo "  OpenAI-compatible clients: base_url https://$fqdn/v1, api_key $key" ;;
  esac
}

cf_unexpose() {
  local name="$1" fqdn r id
  fqdn="$name.$CF_ZONE"
  r="$(cf_api GET "/zones/$CF_ZONE_ID/dns_records?name=$fqdn")"
  id="$(json_get "$r" "d['result'][0]['id'] if d['result'] else ''")"
  [[ -z "$id" ]] || cf_api DELETE "/zones/$CF_ZONE_ID/dns_records/$id" >/dev/null
  cf_ingress del "$fqdn"
  cf_waf_del "$name"
  info "Removed https://$fqdn (Cloudflare)"
}

cf_list() {
  local r ing
  r="$(cf_api GET "/zones/$CF_ZONE_ID/dns_records?per_page=500&comment.startswith=$PG_TAG:")"
  ing="{}"; [[ -n "${CF_TUNNEL_ID:-}" ]] && ing="$(cf_api GET "/accounts/$CF_ACCOUNT/cfd_tunnel/$CF_TUNNEL_ID/configurations")"
  python3 - "$r" "$ing" <<'PY'
import json, sys
recs = json.loads(sys.argv[1])["result"]
cfg = ((json.loads(sys.argv[2]).get("result") or {}).get("config") or {}).get("ingress") or []
svc = {x["hostname"]: x["service"].replace("http://", "") for x in cfg if x.get("hostname")}
rows = ["  %-40s -> %s   (auth: %s)" % ("https://" + r["name"], svc.get(r["name"], "?"), r["comment"].split(":")[2])
        for r in recs if (r.get("comment") or "").startswith("omarchy-remote:")]
print("\n".join(rows) or "  (none)")
PY
}

cmd_cloudflare() {
  case "${1:-}" in
    login)  cf_login ;;
    status) systemctl --user status "$CF_UNIT" --no-pager ;;
    *) die "usage: omarchy-remote cloudflare login|status" ;;
  esac
}

cmd_unexpose() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: omarchy-remote unexpose <name>"
  case "$(expose_owner "$name")" in
    tailscale) ts_unexpose "$name" ;;
    pangolin)
      pg_load   # expose_owner ran in a subshell, so load the ids here too
      pg_api DELETE "/public-resource/$(pg_resource_id "$name.$PG_BASE_DOMAIN")" >/dev/null
      info "Removed https://$name.$PG_BASE_DOMAIN (may keep answering for a few seconds while Pangolin syncs)" ;;
    cloudflare) cf_load; cf_unexpose "$name" ;;
    *) die "'$name' is not exposed (omarchy-remote list)." ;;
  esac
}

cmd_list() {
  echo "Private (Tailscale):"
  if [[ -s "$TS_MAP_FILE" ]]; then
    local base; base="$(ts_url || echo "https://<this-machine>.ts.net")"
    awk -v b="$base" '{ printf "  %-40s -> 127.0.0.1:%s   (%s)\n", b ":" $2, $2, $1 }' "$TS_MAP_FILE"
  else
    echo "  (none)"
  fi
  if [[ -r "$PG_ENV_FILE" ]]; then
    pg_load
    echo "Public (Pangolin):"
    local r; r="$(pg_api GET "/org/$PG_ORG/public-resources?pageSize=1000")"
    json_get "$r" "'\n'.join('  %-40s -> %s   (%s)' % ('https://'+(x.get('fullDomain') or '?'), ', '.join('%s:%s' % (t.get('ip'), t.get('port')) for t in (x.get('targets') or [])), 'auth: '+x['name'].split(':')[2] if x['name'].startswith('$PG_TAG:') else 'made by hand') for x in d['data']['resources']) or '  (none)'"
  fi
  if [[ -r "$CF_ENV_FILE" ]]; then
    cf_load
    echo "Public (Cloudflare):"
    cf_list
  fi
}

cmd_config() {
  [[ "${1:-}" == set && "${2:-}" == public ]] || die "usage: omarchy-remote config set public pangolin|cloudflare"
  case "${3:-}" in pangolin|cloudflare) ;; *) die "usage: omarchy-remote config set public pangolin|cloudflare" ;; esac
  mkdir -p "$(dirname "$CONFIG_FILE")"; touch "$CONFIG_FILE"
  sed -i '/^PUBLIC_VIA=/d' "$CONFIG_FILE"
  echo "PUBLIC_VIA=$3" >> "$CONFIG_FILE"
  info "Public URLs now default to $3 (when --auth is given without --via)"
}

cmd_pangolin() {
  case "${1:-}" in
    connect)
      if ! have pangolin; then
        info "Installing the Pangolin CLI (static.pangolin.net)…"
        curl -fsSL https://static.pangolin.net/get-cli.sh | bash
      fi
      cat <<EOF
In the Pangolin dashboard: Sites -> Add site -> copy the Site ID and Secret.
(The secret is shown only once; regenerate it if it is masked.)
EOF
      local id secret endpoint
      read -rp "Site ID: " id
      read -rsp "Secret (hidden): " secret; echo
      read -rp "Endpoint [$PANGOLIN_ENDPOINT]: " endpoint
      endpoint="${endpoint:-$PANGOLIN_ENDPOINT}"
      [[ -n "$id" && -n "$secret" ]] || die "Site ID and secret are required."
      sudo pangolin service uninstall site >/dev/null 2>&1 || true
      sudo pangolin service install site --id "$id" --secret "$secret" \
        --endpoint "$endpoint" --disable-clients --disable-ssh
      unset secret
      cat <<EOF

Site installed. In the Pangolin dashboard:
  1. Resources -> Add public resource (HTTP), target: http://127.0.0.1:$WEB_PORT on this site
  2. Authentication -> enable "Email whitelist" and add the allowed emails
  3. Prefer your own domain (CNAME, "DNS only") — free tunnel domains get blocked on some networks
EOF
      ;;
    login)      pangolin_login ;;
    status)     sudo pangolin service status site ;;
    logs)       sudo pangolin service logs site ;;
    disconnect) sudo pangolin service uninstall site ;;
    *) die "usage: omarchy-remote pangolin connect|login|status|logs|disconnect" ;;
  esac
}

cmd_quality() {
  [[ "${1:-}" =~ ^[0-9]$ ]] || die "usage: omarchy-remote quality 0-9   (current: $NOVNC_QUALITY)"
  mkdir -p "$(dirname "$CONFIG_FILE")"
  touch "$CONFIG_FILE"
  sed -i '/^NOVNC_QUALITY=/d' "$CONFIG_FILE"
  echo "NOVNC_QUALITY=$1" >> "$CONFIG_FILE"
  NOVNC_QUALITY="$1"
  write_novnc_defaults
  info "Quality set to $1 — reload the browser tab"
}

cmd_restart() {
  systemctl --user restart "$VNC_UNIT" "$WEB_UNIT"
  cmd_status
}

cmd_uninstall() {
  require_user
  info "Stopping and removing services…"
  systemctl --user disable --now "$VNC_UNIT" "$WEB_UNIT" 2>/dev/null || true
  rm -f "$UNIT_DIR/$VNC_UNIT" "$UNIT_DIR/$WEB_UNIT"
  systemctl --user daemon-reload
  if have tailscale && tailscale serve status 2>/dev/null | grep -q "127.0.0.1:$WEB_PORT"; then
    sudo tailscale serve --https=443 off || true
  fi
  if have pangolin && systemctl is-active --quiet pangolin-site 2>/dev/null; then
    read -rp "Also disconnect the Pangolin site? [y/N] " a
    [[ "$a" =~ ^[Yy]$ ]] && sudo pangolin service uninstall site
  fi
  rm -rf "$NOVNC_DIR"
  info "Removed. (wayvnc package left installed: sudo pacman -Rs wayvnc)"
}

usage() {
  cat <<EOF
omarchy-remote $VERSION — reach local services on your Omarchy machine from anywhere

Usage: omarchy-remote <command>

  expose <name> <port>       private URL via Tailscale (default): https://<machine>.ts.net:<port>
  expose <name> <port> --auth login|token|password|none [--allow a@x.com,b@y.com] [--via pangolin]
                             public URL https://<name>.<your-domain> behind the chosen login
  expose <name> <port> --auth bearer|none [--via cloudflare]
                             public URL via Cloudflare; bearer = API key checked at Cloudflare's edge
  unexpose <name>
  list                       show exposed services
  config set public pangolin|cloudflare
                             provider used when --auth is given without --via (default: pangolin)
  setup                      install wayvnc + noVNC and start the desktop services
  status                     show desktop service and publishing status
  tailscale on|off           publish privately to your tailnet (HTTPS)
  pangolin connect           publish via Pangolin (public URL + login)
  pangolin login             store a Pangolin API key (needed by expose)
  cloudflare login|status    store a Cloudflare API token / show the tunnel service
  pangolin status|logs|disconnect
  quality 0-9                image quality (lower = faster on slow links)
  restart                    restart wayvnc + noVNC
  uninstall                  remove services and noVNC
  version
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    setup)          cmd_setup "$@" ;;
    status)         cmd_status "$@" ;;
    expose)         cmd_expose "$@" ;;
    unexpose)       cmd_unexpose "$@" ;;
    list|ls)        cmd_list "$@" ;;
    config)         cmd_config "$@" ;;
    cloudflare)     cmd_cloudflare "$@" ;;
    tailscale)      cmd_tailscale "$@" ;;
    pangolin)       cmd_pangolin "$@" ;;
    quality)        cmd_quality "$@" ;;
    restart)        cmd_restart "$@" ;;
    uninstall)      cmd_uninstall "$@" ;;
    ensure-display) cmd_ensure_display "$@" ;;
    version|-v|--version) echo "$VERSION" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
